# Build folders
**/build/
**/dist/
**/out/

# Dependencies
node_modules/

# Environment variables
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
# Local player data is user/game state, not source assets.
/saves/players/*.json
/saves/players/*.json.bak
/saves/players/*.tmp-*

# Patch-install backups remain local and should not be committed.
/.iskut-backups/
/..iskut-logs/
/build-check/
/.build-check/
/data/cache/item-icons/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*