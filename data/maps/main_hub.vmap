# Iskut handcrafted ocean-world hub, version 3 (Blox-Fruits style square island).
# World surface levels are translated upward by +1.18 to place sea level at Y=1.0.
# Island plateau top is local y=2.0 -> world y=3.18. Structures are authored with ground at y=0, so they are placed at y=3.18.
# The dock is authored with deck top at y=0 and is placed at y=1.18 (sand ledge level).
# To move a building just change its PLACE x/z (door facing: hall/bank/auction = +Z south, blacksmith = -Z north).
SKYVOXEL_MAP 1
MAP Iskut_Ocean_Hub
SPAWN 0 4.18 0 0

# Dedicated ocean plane renders first, is non-collidable, and is excluded from world AO/coplanar batching.
PLACE ocean_surface ../structures/ocean_surface.vstruct 0 1.00 0 0

# Island (plateau, cliff, boundary wall, wet/dry sand ledge, stairs).
PLACE hub_island ../structures/hub_island.vstruct 0 1.18 0 0

# Layout: roads + door stubs.
PLACE hub_layout ../structures/hub_layout.vstruct 0 3.18 0 0

# Structures (each in its own file).
PLACE spawn_pedestal ../structures/spawn_pedestal.vstruct 0 3.18 0 0
PLACE community_hall ../structures/community_hall.vstruct 0 3.18 -29 0
PLACE bank ../structures/bank.vstruct -28 3.18 -12 0
PLACE auction_house ../structures/auction_house.vstruct 28 3.18 -12.5 0
PLACE blacksmith ../structures/blacksmith.vstruct -31 3.18 13 0
PLACE bazaar ../structures/bazaar.vstruct 27 3.18 16 0
PLACE dock ../structures/dock.vstruct 0 1.18 44.5 0

# Decoration.
PLACE hub_props ../structures/hub_props.vstruct 0 3.18 0 0
PLACE hub_palms ../structures/hub_palms.vstruct 0 3.18 0 0

# Mining Island (rocky quarry, cliffs, mine tunnel, props, and dock).
PLACE mine_terrain ../structures/mine_terrain.vstruct 0 1.18 220 0
PLACE mine_props ../structures/mine_props.vstruct 0 1.18 220 0
PLACE mine_dock ../structures/mine_dock.vstruct 0 1.18 220 0

# Old organic island / plaza / portal / old bazaar - replaced.
#PLACE island ../structures/island_terrain.vstruct 0 1.18 0 0
#PLACE plaza_props ../structures/plaza_props.vstruct 0 1.18 0 0
#PLACE beach_transition ../structures/beach_transition.vstruct 0 1.18 0 0
#PLACE portal ../structures/portal_gate.vstruct 0 1.18 0 0
#PLACE bazaar_old ../structures/bazaar_alley.vstruct 18 3 0 0
#PLACE crates ../structures/bazzar_crates.vstruct 22 3.5 4.5 0
