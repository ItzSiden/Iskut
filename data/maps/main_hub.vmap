# Iskut handcrafted ocean-world hub, version 1.
# World surface levels are translated upward by +1.18 to place sea level at Y=1.0; terrain/shore spacing is preserved.
SKYVOXEL_MAP 1
MAP Iskut_Ocean_Hub
SPAWN 0 1.18 12 0

# Dedicated ocean plane renders first, is non-collidable, and is excluded from world AO/coplanar batching.
PLACE ocean_surface ../structures/ocean_surface.vstruct 0 1.00 0 0

# Latest authored island + layered shoreline. Beach transition is walkable, dry/wet sand are real step-down collision surfaces, and shallows/foam are visual-only.
PLACE plaza ../structures/plaza.vstruct 0 1.18 0 0
PLACE beach_transition ../structures/beach_transition.vstruct 0 1.18 0 0

# Core hub structures.
PLACE portal ../structures/portal_gate.vstruct 0 1.18 0 0
#PLACE shops ../structures/merchant_stalls.vstruct 0 1.18 0 0
#PLACE gardens ../structures/gardens.vstruct 0 1.18 0 0
#PLACE lamps ../structures/lamps.vstruct 0 1.18 0 0
#PLACE pickups ../structures/crystal_shrines.vstruct 0 1.18 0 0
#PLACE fountain ../structures/fountain.vstruct 0 1.18 0 0

# Trails and village.
#PLACE path_lamps ../structures/path_lamps.vstruct 0 1.18 0 0
#PLACE market ../structures/market_square.vstruct 22.12 1.18 2.2 0

# Districts.
#PLACE bank ../structures/bank.vstruct -13.5 1.18 21.5 0
#PLACE auction ../structures/auction_house.vstruct 13.5 1.18 24 0
#PLACE blacksmith ../structures/blacksmith.vstruct -24 1.18 33.5 0
PLACE bazaar ../structures/bazaar_alley.vstruct 18 3.2 0 0
#PLACE harbor_east ../structures/harbor_east.vstruct 0 1.18 0 0
#PLACE harbor_sw ../structures/harbor_sw.vstruct 0 1.18 0 0

# Mainland-like elevation and forest.
#PLACE wizard_tower ../structures/wizard_tower.vstruct -27 3.43 -12 0
#PLACE summit ../structures/mountain_summit.vstruct 38.5 5.68 40.5 0
#PLACE forest ../structures/forest.vstruct 0 1.18 0 0
